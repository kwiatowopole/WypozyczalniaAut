<Window x:Class="WypozyczalniaAut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wypożyczalnia Aut" Height="500" Width="800">
    <Grid>
        <TextBlock Text="Wypożyczalnia Samochodów" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top" 
                   Margin="0,10,0,0"/>

        <GroupBox Header="Administratorzy" HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="150" Margin="0,70,0,0">
            <StackPanel VerticalAlignment="Center">
                <Button Name="btnAddAdmin" Content="Poznaj Administratorów" Width="200" Height="40" Click="btnAddAdmin_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Zarządzaj Klientami" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="93,230,0,0" Width="300" Height="150">
            <StackPanel VerticalAlignment="Center">
                <Button Name="btnAddClient" Content="Klienci" Width="200" Height="40" Click="btnAddClient_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Zarządzaj Samochodami" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="403,225,0,0" Width="300" Height="150">
            <StackPanel VerticalAlignment="Center">
                <Button Name="btnAddCar" Content="Przeglądarka Samochodów" Width="200" Height="40" Click="btnAddCar_Click"/>
            </StackPanel>
        </GroupBox>
        <Button Name="btnAddOrder" Content="Dodaj Zamówienie" Width="200" Height="40" 
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,10" Click="btnAddOrder_Click"/>
    </Grid>
</Window>