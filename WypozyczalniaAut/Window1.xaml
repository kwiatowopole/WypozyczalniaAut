<Window x:Class="WypozyczalniaAut.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista Administratorów" Height="300" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

       
        <Button Grid.Row="0" Grid.Column="0" Content="Powrót" Width="80" Height="30" Margin="5" Click="btnBackToMainWindow_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Text="Lista Administratorów" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10" />

        <ListBox Name="lstAdmins" Grid.Row="1" Margin="10" />
    </Grid>
</Window>
